{
  "name": "fieldruntime-core",
  "version": "0.1.0-evaluation-preview.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Self-hosted evaluation preview of the Field Runtime Enterprise Case Runtime",
  "homepage": "https://fieldruntime.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mehtapozkan/fieldruntime-core.git"
  },
  "bugs": {
    "url": "https://github.com/Mehtapozkan/fieldruntime-core/issues"
  },
  "type": "module",
  "bin": {
    "fr": "dist/packages/cli/src/cli.js"
  },
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "build": "pnpm clean && tsc -p tsconfig.json && node scripts/copy-static.mjs",
    "clean": "node scripts/clean.mjs",
    "eval:ecc": "pnpm build && node dist/packages/ecc-pack/src/cli.js",
    "eval:ecc:json": "pnpm build && node dist/packages/ecc-pack/src/cli.js --json",
    "fr": "pnpm build && node dist/packages/cli/src/cli.js",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint .",
    "release:check": "node scripts/check-public-release.mjs",
    "test": "pnpm build && node --test tests/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm release:check"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "pg": "8.23.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "eslint": "10.9.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0"
  }
}
