{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fieldruntime.ai/schemas/guided-walkthrough.v0.schema.json",
  "title": "Field Runtime Guided Walkthrough v0",
  "description": "A synthetic, non-authoritative presentation contract for the PR5 evaluation workbench. It describes simulated observations and never grants authority, performs an external write, or emits a production receipt.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "walkthrough_id",
    "title",
    "pack",
    "safety",
    "source_fixture",
    "stages"
  ],
  "properties": {
    "schema_version": {
      "const": "guided-walkthrough.v0"
    },
    "walkthrough_id": {
      "$ref": "#/$defs/Id"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "pack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "workflow_id"],
      "properties": {
        "id": {
          "const": "ecc"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "workflow_id": {
          "const": "customer_escalation_commitment_control"
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "immutable",
        "synthetic",
        "simulation",
        "authoritative",
        "replayable",
        "external_writes",
        "authority_effects",
        "production_receipt"
      ],
      "properties": {
        "immutable": {
          "const": true
        },
        "synthetic": {
          "const": true
        },
        "simulation": {
          "const": true
        },
        "authoritative": {
          "const": false
        },
        "replayable": {
          "const": false
        },
        "external_writes": {
          "const": false
        },
        "authority_effects": {
          "const": false
        },
        "production_receipt": {
          "const": false
        }
      }
    },
    "source_fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixture_id",
        "fixture_hash",
        "tenant_id",
        "case_id",
        "workflow_version_id"
      ],
      "properties": {
        "fixture_id": {
          "$ref": "#/$defs/Id"
        },
        "fixture_hash": {
          "$ref": "#/$defs/Sha256"
        },
        "tenant_id": {
          "$ref": "#/$defs/Id"
        },
        "case_id": {
          "$ref": "#/$defs/Id"
        },
        "workflow_version_id": {
          "$ref": "#/$defs/Id"
        }
      }
    },
    "stages": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case", "decision", "act_verify", "receipt_preview"],
      "properties": {
        "case": {
          "$ref": "#/$defs/CaseStage"
        },
        "decision": {
          "$ref": "#/$defs/DecisionStage"
        },
        "act_verify": {
          "$ref": "#/$defs/ActVerifyStage"
        },
        "receipt_preview": {
          "$ref": "#/$defs/ReceiptPreviewStage"
        }
      }
    }
  },
  "$defs": {
    "Id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,127}$"
    },
    "Sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "CanonicalUtcInstant": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "NonemptyText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "ActionBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_id", "payload_hash", "idempotency_key"],
      "properties": {
        "action_id": {
          "$ref": "#/$defs/Id"
        },
        "payload_hash": {
          "$ref": "#/$defs/Sha256"
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        }
      }
    },
    "CaseStage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage_id",
        "title",
        "narrative",
        "evidence_bindings",
        "conflict_artifact_id"
      ],
      "properties": {
        "stage_id": {
          "const": "case"
        },
        "title": {
          "$ref": "#/$defs/NonemptyText"
        },
        "narrative": {
          "$ref": "#/$defs/NonemptyText"
        },
        "evidence_bindings": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["evidence_id", "role", "headline"],
            "properties": {
              "evidence_id": {
                "$ref": "#/$defs/Id"
              },
              "role": {
                "enum": [
                  "source_claim",
                  "customer_record",
                  "engineering_state",
                  "governing_policy"
                ]
              },
              "headline": {
                "$ref": "#/$defs/NonemptyText"
              }
            }
          }
        },
        "conflict_artifact_id": {
          "$ref": "#/$defs/Id"
        }
      }
    },
    "DecisionStage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage_id",
        "title",
        "decision_packet_id",
        "recommendation",
        "options",
        "authority_exception"
      ],
      "properties": {
        "stage_id": {
          "const": "decision"
        },
        "title": {
          "$ref": "#/$defs/NonemptyText"
        },
        "decision_packet_id": {
          "$ref": "#/$defs/Id"
        },
        "recommendation": {
          "$ref": "#/$defs/NonemptyText"
        },
        "options": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action_id",
              "payload_hash",
              "label",
              "risk_level",
              "required_approval_roles",
              "authority_message"
            ],
            "properties": {
              "action_id": {
                "$ref": "#/$defs/Id"
              },
              "payload_hash": {
                "$ref": "#/$defs/Sha256"
              },
              "label": {
                "$ref": "#/$defs/NonemptyText"
              },
              "risk_level": {
                "enum": ["low", "medium", "high", "critical"]
              },
              "required_approval_roles": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/NonemptyText"
                }
              },
              "authority_message": {
                "$ref": "#/$defs/NonemptyText"
              }
            }
          }
        },
        "authority_exception": {
          "type": "object",
          "additionalProperties": false,
          "required": ["action_id", "missing_roles", "disposition"],
          "properties": {
            "action_id": {
              "$ref": "#/$defs/Id"
            },
            "missing_roles": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/NonemptyText"
              }
            },
            "disposition": {
              "const": "human_approval_required"
            }
          }
        }
      }
    },
    "Attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt_id",
        "sequence",
        "previous_attempt_id",
        "action",
        "mode",
        "simulated_connector_response",
        "independent_readback",
        "effect_acceptance_evaluation",
        "simulated_result"
      ],
      "properties": {
        "attempt_id": {
          "$ref": "#/$defs/Id"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "previous_attempt_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "action": {
          "$ref": "#/$defs/ActionBinding"
        },
        "mode": {
          "const": "guided_simulation"
        },
        "simulated_connector_response": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "adapter_identity_id",
            "status",
            "reported_at",
            "production_receipt"
          ],
          "properties": {
            "adapter_identity_id": {
              "$ref": "#/$defs/Id"
            },
            "status": {
              "const": "reported_success"
            },
            "reported_at": {
              "$ref": "#/$defs/CanonicalUtcInstant"
            },
            "production_receipt": {
              "const": false
            }
          }
        },
        "independent_readback": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "verifier_identity_id",
            "source",
            "expected_value",
            "observed_value",
            "result",
            "observed_at"
          ],
          "properties": {
            "verifier_identity_id": {
              "$ref": "#/$defs/Id"
            },
            "source": {
              "type": "string",
              "pattern": "^fixture://.+",
              "maxLength": 500
            },
            "expected_value": {
              "type": "object",
              "additionalProperties": false,
              "required": ["message"],
              "properties": {
                "message": {
                  "$ref": "#/$defs/NonemptyText"
                }
              }
            },
            "observed_value": {
              "type": "object",
              "additionalProperties": false,
              "required": ["message"],
              "properties": {
                "message": {
                  "oneOf": [
                    {
                      "$ref": "#/$defs/NonemptyText"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            },
            "result": {
              "enum": ["mismatch", "match"]
            },
            "observed_at": {
              "$ref": "#/$defs/CanonicalUtcInstant"
            }
          }
        },
        "effect_acceptance_evaluation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "decision",
            "reasons",
            "authoritative_transition_applied"
          ],
          "properties": {
            "decision": {
              "enum": ["rejected", "accepted_simulation_only"]
            },
            "reasons": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/NonemptyText"
              }
            },
            "authoritative_transition_applied": {
              "const": false
            }
          }
        },
        "simulated_result": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "accepted"],
          "properties": {
            "status": {
              "enum": ["effect_rejected", "effect_accepted_simulation_only"]
            },
            "accepted": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "ActVerifyStage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage_id",
        "title",
        "selected_action",
        "authority_preview",
        "attempts",
        "recovery_strategy",
        "authoritative_case_state",
        "external_effect_count",
        "production_receipt_emitted"
      ],
      "properties": {
        "stage_id": {
          "const": "act_verify"
        },
        "title": {
          "$ref": "#/$defs/NonemptyText"
        },
        "selected_action": {
          "$ref": "#/$defs/ActionBinding"
        },
        "authority_preview": {
          "type": "object",
          "additionalProperties": false,
          "required": ["action_id", "required_roles", "status"],
          "properties": {
            "action_id": {
              "$ref": "#/$defs/Id"
            },
            "required_roles": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/NonemptyText"
              }
            },
            "status": {
              "const": "simulation_only_no_approval_recorded"
            }
          }
        },
        "attempts": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/Attempt"
          }
        },
        "recovery_strategy": {
          "$ref": "#/$defs/NonemptyText"
        },
        "authoritative_case_state": {
          "const": "needs_review"
        },
        "external_effect_count": {
          "const": 0
        },
        "production_receipt_emitted": {
          "const": false
        }
      }
    },
    "ReceiptPreviewStage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage_id",
        "title",
        "kind",
        "production_receipt",
        "trace",
        "correction_preview",
        "learning_candidate_preview"
      ],
      "properties": {
        "stage_id": {
          "const": "receipt_preview"
        },
        "title": {
          "$ref": "#/$defs/NonemptyText"
        },
        "kind": {
          "const": "guided_simulation_trace"
        },
        "production_receipt": {
          "const": false
        },
        "trace": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sequence", "kind", "ref_id", "label"],
            "properties": {
              "sequence": {
                "type": "integer",
                "minimum": 1
              },
              "kind": {
                "enum": [
                  "evidence",
                  "recommendation",
                  "authority",
                  "payload",
                  "connector_response",
                  "independent_verification",
                  "effect_rejection",
                  "accepted_simulated_result",
                  "correction"
                ]
              },
              "ref_id": {
                "$ref": "#/$defs/Id"
              },
              "label": {
                "$ref": "#/$defs/NonemptyText"
              }
            }
          }
        },
        "correction_preview": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "correction_id",
            "based_on_attempt_id",
            "statement",
            "append_only_preview"
          ],
          "properties": {
            "correction_id": {
              "$ref": "#/$defs/Id"
            },
            "based_on_attempt_id": {
              "$ref": "#/$defs/Id"
            },
            "statement": {
              "$ref": "#/$defs/NonemptyText"
            },
            "append_only_preview": {
              "const": true
            }
          }
        },
        "learning_candidate_preview": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "candidate_id",
            "source_correction_id",
            "title",
            "status",
            "promotion_authorized",
            "original_history_mutated"
          ],
          "properties": {
            "candidate_id": {
              "$ref": "#/$defs/Id"
            },
            "source_correction_id": {
              "$ref": "#/$defs/Id"
            },
            "title": {
              "$ref": "#/$defs/NonemptyText"
            },
            "status": {
              "const": "preview_not_promoted"
            },
            "promotion_authorized": {
              "const": false
            },
            "original_history_mutated": {
              "const": false
            }
          }
        }
      }
    }
  }
}
