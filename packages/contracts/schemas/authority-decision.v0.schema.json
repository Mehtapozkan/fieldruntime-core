{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fieldruntime.ai/schemas/authority-decision.v0.schema.json",
  "title": "Field Runtime Authority Decision v0",
  "description": "An attributable authority decision bound to one Authority Request, Case version, proposed consequence hash, and policy version.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "authority_decision_id",
    "authority_request_id",
    "tenant_id",
    "approver_identity",
    "case_id",
    "case_version",
    "proposed_consequence_hash",
    "policy_reference",
    "decision",
    "decided_at",
    "decided_at_source_timezone",
    "correlation_id",
    "lineage"
  ],
  "properties": {
    "schema_version": {
      "const": "authority-decision.v0"
    },
    "authority_decision_id": {
      "$ref": "#/$defs/Id"
    },
    "authority_request_id": {
      "$ref": "#/$defs/Id"
    },
    "tenant_id": {
      "$ref": "#/$defs/Id"
    },
    "approver_identity": {
      "$ref": "https://fieldruntime.ai/schemas/identity-reference.v0.schema.json"
    },
    "case_id": {
      "$ref": "#/$defs/Id"
    },
    "case_version": {
      "type": "integer",
      "minimum": 1
    },
    "proposed_consequence_hash": {
      "$ref": "#/$defs/Sha256"
    },
    "policy_reference": {
      "$ref": "#/$defs/PolicyReference"
    },
    "decision": {
      "enum": ["approve", "reject", "modify", "escalate"]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "relevant_delegation_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/Id"
      }
    },
    "replacement_authority_request_id": {
      "$ref": "#/$defs/Id"
    },
    "decided_at": {
      "$ref": "#/$defs/CanonicalUtcInstant"
    },
    "decided_at_source_timezone": {
      "$ref": "#/$defs/SourceTimezone"
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "causation_event_id": {
      "$ref": "#/$defs/Id"
    },
    "lineage": {
      "$ref": "#/$defs/DecisionLineage"
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["decision"],
        "properties": {
          "decision": {
            "const": "modify"
          }
        }
      },
      "then": {
        "properties": {
          "replacement_authority_request_id": {
            "$ref": "#/$defs/Id"
          }
        },
        "required": ["replacement_authority_request_id"]
      },
      "else": {
        "not": {
          "properties": {
            "replacement_authority_request_id": {}
          },
          "required": ["replacement_authority_request_id"]
        }
      }
    }
  ],
  "$defs": {
    "Id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,127}$"
    },
    "Sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "CanonicalUtcInstant": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "SourceTimezone": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^(?:UTC(?:[+-](?:0[0-9]|1[0-9]|2[0-3]):[0-5][0-9])?|[A-Za-z][A-Za-z0-9._+-]*(?:/[A-Za-z0-9._+-]+)+)$"
    },
    "PolicyReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "policy_version"],
      "properties": {
        "policy_id": {
          "$ref": "#/$defs/Id"
        },
        "policy_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "DecisionLineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recorded_by_identity",
        "recorded_at",
        "recorded_at_source_timezone",
        "source_refs"
      ],
      "properties": {
        "recorded_by_identity": {
          "$ref": "https://fieldruntime.ai/schemas/identity-reference.v0.schema.json"
        },
        "recorded_at": {
          "$ref": "#/$defs/CanonicalUtcInstant"
        },
        "recorded_at_source_timezone": {
          "$ref": "#/$defs/SourceTimezone"
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        }
      }
    }
  }
}
