{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fieldruntime.ai/schemas/authority-request-read-response.v1.schema.json",
  "title": "Field Runtime authority-request-read-response.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tenant_id",
    "case_id",
    "authority_request_id",
    "request",
    "request_binding_hash",
    "case_version",
    "review_revision",
    "authority_state_revision",
    "evaluated_at",
    "evaluated_at_source_timezone",
    "material",
    "history",
    "historical_evaluations",
    "current",
    "implementation_versions",
    "simulation",
    "action_permission"
  ],
  "properties": {
    "schema_version": {
      "const": "authority-request-read-response.v1"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,127}$"
    },
    "case_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,127}$"
    },
    "authority_request_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,127}$"
    },
    "request": {
      "$ref": "https://fieldruntime.ai/schemas/authority-request.v1.schema.json"
    },
    "request_binding_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "case_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "review_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "authority_state_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "evaluated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "evaluated_at_source_timezone": {
      "const": "UTC"
    },
    "material": {
      "$ref": "https://fieldruntime.ai/schemas/authority-review-support.v1.schema.json#/$defs/material"
    },
    "history": {
      "type": "array",
      "items": {
        "$ref": "https://fieldruntime.ai/schemas/authority-request-journal-entry.v1.schema.json"
      }
    },
    "historical_evaluations": {
      "type": "array",
      "items": {
        "$ref": "https://fieldruntime.ai/schemas/authority-review-support.v1.schema.json#/$defs/evaluation_snapshot"
      }
    },
    "current": {
      "$ref": "https://fieldruntime.ai/schemas/authority-review-support.v1.schema.json#/$defs/evaluation"
    },
    "implementation_versions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine",
        "resolver",
        "projection"
      ],
      "properties": {
        "engine": {
          "const": "authority-review-engine.v1"
        },
        "resolver": {
          "enum": ["authority-resolution.d6c.v1", "authority-resolution.d6c.v2"]
        },
        "projection": {
          "const": "authority-packet.v1"
        }
      }
    },
    "simulation": {
      "const": true
    },
    "action_permission": {
      "const": false
    }
  }
}
