{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fieldruntime.ai/schemas/authority-command.dispute.v1.schema.json",
  "title": "Field Runtime authority-command.dispute.v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "tenant_id",
        "case_id",
        "expected_case_version",
        "expected_authority_state_revision",
        "idempotency_key",
        "correlation_id",
        "proposal_key",
        "schema_version",
        "material",
        "result_context"
      ],
      "properties": {
        "type": {
          "const": "authority.request.create"
        },
        "tenant_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,127}$"
        },
        "case_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,127}$"
        },
        "expected_case_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "expected_authority_state_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "correlation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "proposal_key": {
          "const": "uphold_invoice_no_adjustment"
        },
        "predecessor_authority_request_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,127}$"
        },
        "schema_version": {
          "const": "authority-command.dispute.v1"
        },
        "material": {
          "$ref": "https://fieldruntime.ai/schemas/authority-review-support.dispute.v1.schema.json#/$defs/material"
        },
        "result_context": {
          "$ref": "https://fieldruntime.ai/schemas/dispute-result.v1.schema.json#/$defs/authority_context"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "tenant_id",
        "case_id",
        "expected_case_version",
        "expected_authority_state_revision",
        "idempotency_key",
        "correlation_id",
        "authority_request_id",
        "expected_review_revision",
        "request_binding_hash",
        "decision",
        "schema_version",
        "result_context"
      ],
      "properties": {
        "type": {
          "const": "authority.request.decide"
        },
        "tenant_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,127}$"
        },
        "case_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,127}$"
        },
        "expected_case_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "expected_authority_state_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "correlation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "authority_request_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,127}$"
        },
        "expected_review_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "request_binding_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "decision": {
          "enum": [
            "approve",
            "reject",
            "modify",
            "escalate"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "replacement_proposal_key": {
          "const": "uphold_invoice_no_adjustment"
        },
        "schema_version": {
          "const": "authority-command.dispute.v1"
        },
        "material": {
          "$ref": "https://fieldruntime.ai/schemas/authority-review-support.dispute.v1.schema.json#/$defs/material"
        },
        "result_context": {
          "$ref": "https://fieldruntime.ai/schemas/dispute-result.v1.schema.json#/$defs/authority_context"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "decision": {
                "const": "modify"
              }
            },
            "required": [
              "decision"
            ]
          },
          "then": {
            "required": [
              "replacement_proposal_key",
              "reason"
            ],
            "properties": {
              "replacement_proposal_key": {},
              "reason": {}
            }
          },
          "else": {
            "not": {
              "required": [
                "replacement_proposal_key"
              ],
              "properties": {
                "replacement_proposal_key": {}
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "decision": {
                "enum": [
                  "reject",
                  "escalate"
                ]
              }
            },
            "required": [
              "decision"
            ]
          },
          "then": {
            "required": [
              "reason"
            ],
            "properties": {
              "reason": {}
            }
          }
        }
      ]
    }
  ]
}
