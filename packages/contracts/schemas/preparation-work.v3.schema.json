{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fieldruntime.dev/schemas/preparation-work.v3.schema.json",
  "title": "Accepted D-038: bounded two-bundle preparation and mixed immutable history",
  "$defs": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "synthetic-preparation-worker.v3"
        },
        "tenant_id": {
          "$ref": "https://fieldruntime.dev/schemas/preparation-work.v1.schema.json#/$defs/profile/properties/tenant_id"
        },
        "profile_id": {
          "$ref": "https://fieldruntime.dev/schemas/preparation-work.v1.schema.json#/$defs/profile/properties/profile_id"
        },
        "implementation_id": {
          "const": "disposition-investigation.v1"
        },
        "identities": {
          "type": "array",
          "items": {
            "$ref": "https://fieldruntime.ai/schemas/identity-reference.v0.schema.json"
          },
          "maxItems": 10
        },
        "read_scope_ids": {
          "$ref": "https://fieldruntime.dev/schemas/preparation-work.v1.schema.json#/$defs/profile/properties/read_scope_ids"
        },
        "work_scope_ids": {
          "$ref": "https://fieldruntime.dev/schemas/preparation-work.v1.schema.json#/$defs/profile/properties/work_scope_ids"
        },
        "grants": {
          "$ref": "https://fieldruntime.dev/schemas/preparation-work.v1.schema.json#/$defs/profile/properties/grants"
        },
        "investigation": {
          "$ref": "https://fieldruntime.dev/schemas/investigation.v1.schema.json#/$defs/profile"
        }
      },
      "required": [
        "schema_version",
        "tenant_id",
        "profile_id",
        "implementation_id",
        "identities",
        "read_scope_ids",
        "work_scope_ids",
        "grants",
        "investigation"
      ]
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tenant_id": {
          "$ref": "https://fieldruntime.dev/schemas/preparation-work.v1.schema.json#/$defs/binding/properties/tenant_id"
        },
        "case_id": {
          "$ref": "https://fieldruntime.dev/schemas/preparation-work.v1.schema.json#/$defs/binding/properties/case_id"
        },
        "record_key": {
          "$ref": "https://fieldruntime.dev/schemas/preparation-work.v1.schema.json#/$defs/binding/properties/record_key"
        },
        "entity_id": {
          "$ref": "https://fieldruntime.dev/schemas/preparation-work.v1.schema.json#/$defs/binding/properties/entity_id"
        },
        "source_revision": {
          "$ref": "https://fieldruntime.dev/schemas/preparation-work.v1.schema.json#/$defs/binding/properties/source_revision"
        },
        "pack_id": {
          "$ref": "https://fieldruntime.dev/schemas/preparation-work.v1.schema.json#/$defs/binding/properties/pack_id"
        },
        "pack_version": {
          "$ref": "https://fieldruntime.dev/schemas/preparation-work.v1.schema.json#/$defs/binding/properties/pack_version"
        },
        "artifact_hash": {
          "$ref": "https://fieldruntime.dev/schemas/preparation-work.v1.schema.json#/$defs/binding/properties/artifact_hash"
        },
        "selection_revision": {
          "$ref": "https://fieldruntime.dev/schemas/preparation-work.v1.schema.json#/$defs/binding/properties/selection_revision"
        },
        "selection_head": {
          "$ref": "https://fieldruntime.dev/schemas/preparation-work.v1.schema.json#/$defs/binding/properties/selection_head"
        },
        "basis": {
          "$ref": "https://fieldruntime.dev/schemas/preparation-pack.v4.schema.json#/$defs/binding"
        },
        "worker_implementation_id": {
          "const": "disposition-investigation.v1"
        },
        "worker_profile_hash": {
          "$ref": "https://fieldruntime.dev/schemas/preparation-work.v1.schema.json#/$defs/binding/properties/worker_profile_hash"
        },
        "retained_bundles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "bundle_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "bundle_hash": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              }
            },
            "required": [
              "bundle_id",
              "bundle_hash"
            ]
          }
        }
      },
      "required": [
        "tenant_id",
        "case_id",
        "record_key",
        "entity_id",
        "source_revision",
        "pack_id",
        "pack_version",
        "artifact_hash",
        "selection_revision",
        "selection_head",
        "basis",
        "worker_implementation_id",
        "worker_profile_hash",
        "retained_bundles"
      ]
    },
    "start": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "preparation-work-command.v3"
        },
        "operation": {
          "$ref": "https://fieldruntime.dev/schemas/preparation-work.v1.schema.json#/$defs/start/properties/operation"
        },
        "binding": {
          "$ref": "#/$defs/binding"
        },
        "expected_work_revision": {
          "$ref": "https://fieldruntime.dev/schemas/preparation-work.v1.schema.json#/$defs/start/properties/expected_work_revision"
        },
        "expected_work_head": {
          "$ref": "https://fieldruntime.dev/schemas/preparation-work.v1.schema.json#/$defs/start/properties/expected_work_head"
        },
        "idempotency_key": {
          "$ref": "https://fieldruntime.dev/schemas/preparation-work.v1.schema.json#/$defs/start/properties/idempotency_key"
        },
        "replaces_invocation": {
          "$ref": "https://fieldruntime.dev/schemas/preparation-work.v1.schema.json#/$defs/start/properties/replaces_invocation"
        }
      },
      "required": [
        "schema_version",
        "operation",
        "binding",
        "expected_work_revision",
        "expected_work_head",
        "idempotency_key",
        "replaces_invocation"
      ]
    },
    "interrupt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "preparation-interruption.v3"
        },
        "operation": {
          "$ref": "https://fieldruntime.dev/schemas/preparation-work.v1.schema.json#/$defs/interrupt/properties/operation"
        },
        "invocation_id": {
          "$ref": "https://fieldruntime.dev/schemas/preparation-work.v1.schema.json#/$defs/interrupt/properties/invocation_id"
        },
        "expected_work_revision": {
          "$ref": "https://fieldruntime.dev/schemas/preparation-work.v1.schema.json#/$defs/interrupt/properties/expected_work_revision"
        },
        "expected_work_head": {
          "$ref": "https://fieldruntime.dev/schemas/preparation-work.v1.schema.json#/$defs/interrupt/properties/expected_work_head"
        },
        "idempotency_key": {
          "$ref": "https://fieldruntime.dev/schemas/preparation-work.v1.schema.json#/$defs/interrupt/properties/idempotency_key"
        },
        "reason": {
          "$ref": "https://fieldruntime.dev/schemas/preparation-work.v1.schema.json#/$defs/interrupt/properties/reason"
        }
      },
      "required": [
        "schema_version",
        "operation",
        "invocation_id",
        "expected_work_revision",
        "expected_work_head",
        "idempotency_key",
        "reason"
      ]
    },
    "task_review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "preparation-task-review.v3"
        },
        "operation": {
          "$ref": "https://fieldruntime.dev/schemas/preparation-work.v1.schema.json#/$defs/task_review/properties/operation"
        },
        "purpose": {
          "$ref": "https://fieldruntime.dev/schemas/preparation-work.v1.schema.json#/$defs/task_review/properties/purpose"
        },
        "invocation_id": {
          "$ref": "https://fieldruntime.dev/schemas/preparation-work.v1.schema.json#/$defs/task_review/properties/invocation_id"
        },
        "expected_work_revision": {
          "$ref": "https://fieldruntime.dev/schemas/preparation-work.v1.schema.json#/$defs/task_review/properties/expected_work_revision"
        },
        "expected_work_head": {
          "$ref": "https://fieldruntime.dev/schemas/preparation-work.v1.schema.json#/$defs/task_review/properties/expected_work_head"
        },
        "idempotency_key": {
          "$ref": "https://fieldruntime.dev/schemas/preparation-work.v1.schema.json#/$defs/task_review/properties/idempotency_key"
        },
        "result_hash": {
          "$ref": "https://fieldruntime.dev/schemas/preparation-work.v1.schema.json#/$defs/task_review/properties/result_hash"
        },
        "decision": {
          "$ref": "https://fieldruntime.dev/schemas/preparation-work.v1.schema.json#/$defs/task_review/properties/decision"
        },
        "reason": {
          "$ref": "https://fieldruntime.dev/schemas/preparation-work.v1.schema.json#/$defs/task_review/properties/reason"
        },
        "replacement_proposal": {
          "$ref": "https://fieldruntime.dev/schemas/preparation-work.v1.schema.json#/$defs/task_review/properties/replacement_proposal"
        }
      },
      "required": [
        "schema_version",
        "operation",
        "purpose",
        "invocation_id",
        "expected_work_revision",
        "expected_work_head",
        "idempotency_key",
        "result_hash",
        "decision",
        "reason"
      ]
    },
    "correction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "purpose_limited_preparation_correction.v3"
        },
        "operation": {
          "const": "correction"
        },
        "purpose": {
          "const": "preparation_usefulness"
        },
        "invocation_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,127}$"
        },
        "expected_work_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "expected_work_head": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "binding_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "original_result_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "target": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "before": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16000
        },
        "after": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16000
        },
        "classification": {
          "enum": [
            "knowledge_bearing",
            "authority_only"
          ]
        },
        "primary_reason": {
          "anyOf": [
            {
              "enum": [
                "AUTHORITY",
                "JUDGMENT",
                "MISSING_EVIDENCE",
                "MISSING_KNOWLEDGE",
                "NOVEL_CASE",
                "SYSTEM_FAILURE"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "citation_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "maxItems": 200
        },
        "evidence_limits": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "maxItems": 20
        }
      },
      "required": [
        "schema_version",
        "operation",
        "purpose",
        "invocation_id",
        "expected_work_revision",
        "expected_work_head",
        "idempotency_key",
        "binding_hash",
        "original_result_hash",
        "target",
        "before",
        "after",
        "classification",
        "primary_reason",
        "reason",
        "citation_ids",
        "evidence_limits"
      ]
    },
    "evaluation_review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "preparation-evaluation-review.v3"
        },
        "operation": {
          "$ref": "https://fieldruntime.dev/schemas/preparation-work.v1.schema.json#/$defs/evaluation_review/properties/operation"
        },
        "purpose": {
          "$ref": "https://fieldruntime.dev/schemas/preparation-work.v1.schema.json#/$defs/evaluation_review/properties/purpose"
        },
        "invocation_id": {
          "$ref": "https://fieldruntime.dev/schemas/preparation-work.v1.schema.json#/$defs/evaluation_review/properties/invocation_id"
        },
        "expected_work_revision": {
          "$ref": "https://fieldruntime.dev/schemas/preparation-work.v1.schema.json#/$defs/evaluation_review/properties/expected_work_revision"
        },
        "expected_work_head": {
          "$ref": "https://fieldruntime.dev/schemas/preparation-work.v1.schema.json#/$defs/evaluation_review/properties/expected_work_head"
        },
        "idempotency_key": {
          "$ref": "https://fieldruntime.dev/schemas/preparation-work.v1.schema.json#/$defs/evaluation_review/properties/idempotency_key"
        },
        "correction_entry_hash": {
          "$ref": "https://fieldruntime.dev/schemas/preparation-work.v1.schema.json#/$defs/evaluation_review/properties/correction_entry_hash"
        },
        "candidate_id": {
          "$ref": "https://fieldruntime.dev/schemas/preparation-work.v1.schema.json#/$defs/evaluation_review/properties/candidate_id"
        },
        "expected_candidate_revision": {
          "$ref": "https://fieldruntime.dev/schemas/preparation-work.v1.schema.json#/$defs/evaluation_review/properties/expected_candidate_revision"
        },
        "expected_test_case_hash": {
          "$ref": "https://fieldruntime.dev/schemas/preparation-work.v1.schema.json#/$defs/evaluation_review/properties/expected_test_case_hash"
        },
        "decision": {
          "$ref": "https://fieldruntime.dev/schemas/preparation-work.v1.schema.json#/$defs/evaluation_review/properties/decision"
        },
        "reason": {
          "$ref": "https://fieldruntime.dev/schemas/preparation-work.v1.schema.json#/$defs/evaluation_review/properties/reason"
        },
        "test_references": {
          "$ref": "https://fieldruntime.dev/schemas/preparation-work.v1.schema.json#/$defs/evaluation_review/properties/test_references"
        }
      },
      "required": [
        "schema_version",
        "operation",
        "purpose",
        "invocation_id",
        "expected_work_revision",
        "expected_work_head",
        "idempotency_key",
        "correction_entry_hash",
        "candidate_id",
        "expected_candidate_revision",
        "expected_test_case_hash",
        "decision",
        "reason",
        "test_references"
      ]
    },
    "note": {
      "$ref": "https://fieldruntime.dev/schemas/preparation-work.v1.schema.json#/$defs/note"
    },
    "proof_note": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "preparation-proof-note.v3"
        },
        "operation": {
          "$ref": "https://fieldruntime.dev/schemas/preparation-work.v1.schema.json#/$defs/proof_note/properties/operation"
        },
        "purpose": {
          "$ref": "https://fieldruntime.dev/schemas/preparation-work.v1.schema.json#/$defs/proof_note/properties/purpose"
        },
        "invocation_id": {
          "$ref": "https://fieldruntime.dev/schemas/preparation-work.v1.schema.json#/$defs/proof_note/properties/invocation_id"
        },
        "expected_work_revision": {
          "$ref": "https://fieldruntime.dev/schemas/preparation-work.v1.schema.json#/$defs/proof_note/properties/expected_work_revision"
        },
        "expected_work_head": {
          "$ref": "https://fieldruntime.dev/schemas/preparation-work.v1.schema.json#/$defs/proof_note/properties/expected_work_head"
        },
        "idempotency_key": {
          "$ref": "https://fieldruntime.dev/schemas/preparation-work.v1.schema.json#/$defs/proof_note/properties/idempotency_key"
        },
        "binding_hash": {
          "$ref": "https://fieldruntime.dev/schemas/preparation-work.v1.schema.json#/$defs/proof_note/properties/binding_hash"
        },
        "result_hash": {
          "$ref": "https://fieldruntime.dev/schemas/preparation-work.v1.schema.json#/$defs/proof_note/properties/result_hash"
        },
        "note": {
          "$ref": "#/$defs/note"
        },
        "reason": {
          "$ref": "https://fieldruntime.dev/schemas/preparation-work.v1.schema.json#/$defs/proof_note/properties/reason"
        }
      },
      "required": [
        "schema_version",
        "operation",
        "purpose",
        "invocation_id",
        "expected_work_revision",
        "expected_work_head",
        "idempotency_key",
        "binding_hash",
        "result_hash",
        "note",
        "reason"
      ]
    },
    "command": {
      "oneOf": [
        {
          "$ref": "#/$defs/start"
        },
        {
          "$ref": "#/$defs/interrupt"
        },
        {
          "$ref": "#/$defs/task_review"
        },
        {
          "$ref": "#/$defs/correction"
        },
        {
          "$ref": "#/$defs/evaluation_review"
        },
        {
          "$ref": "#/$defs/proof_note"
        }
      ]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "disposition-preparation-result.v3"
        },
        "invocation_id": {
          "$ref": "https://fieldruntime.dev/schemas/preparation-work.v1.schema.json#/$defs/result/properties/invocation_id"
        },
        "started_entry_hash": {
          "$ref": "https://fieldruntime.dev/schemas/preparation-work.v1.schema.json#/$defs/result/properties/started_entry_hash"
        },
        "binding_hash": {
          "$ref": "https://fieldruntime.dev/schemas/preparation-work.v1.schema.json#/$defs/result/properties/binding_hash"
        },
        "outcome": {
          "$ref": "https://fieldruntime.dev/schemas/preparation-work.v1.schema.json#/$defs/result/properties/outcome"
        },
        "title": {
          "$ref": "https://fieldruntime.dev/schemas/preparation-work.v1.schema.json#/$defs/result/properties/title"
        },
        "subject": {
          "$ref": "https://fieldruntime.dev/schemas/preparation-work.v1.schema.json#/$defs/result/properties/subject"
        },
        "coverage": {
          "$ref": "https://fieldruntime.dev/schemas/preparation-work.v1.schema.json#/$defs/result/properties/coverage"
        },
        "steps": {
          "$ref": "https://fieldruntime.dev/schemas/preparation-work.v1.schema.json#/$defs/result/properties/steps"
        },
        "evidence_checklist": {
          "$ref": "https://fieldruntime.dev/schemas/preparation-work.v1.schema.json#/$defs/result/properties/evidence_checklist"
        },
        "reconciliation": {
          "$ref": "https://fieldruntime.dev/schemas/preparation-work.v1.schema.json#/$defs/result/properties/reconciliation"
        },
        "related_context": {
          "$ref": "https://fieldruntime.dev/schemas/preparation-work.v1.schema.json#/$defs/result/properties/related_context"
        },
        "follow_up": {
          "$ref": "https://fieldruntime.dev/schemas/preparation-work.v1.schema.json#/$defs/result/properties/follow_up"
        },
        "disposition": {
          "$ref": "https://fieldruntime.dev/schemas/preparation-work.v1.schema.json#/$defs/result/properties/disposition"
        },
        "intervention": {
          "$ref": "https://fieldruntime.dev/schemas/preparation-work.v1.schema.json#/$defs/result/properties/intervention"
        },
        "proof_readiness": {
          "$ref": "https://fieldruntime.dev/schemas/preparation-work.v1.schema.json#/$defs/result/properties/proof_readiness"
        },
        "execution_facts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "model_calls": {
              "const": 1
            },
            "external_tool_calls": {
              "const": 0
            },
            "messages_sent": {
              "const": 0
            }
          },
          "required": [
            "model_calls",
            "external_tool_calls",
            "messages_sent"
          ]
        },
        "cost_evidence": {
          "$ref": "https://fieldruntime.dev/schemas/preparation-work.v1.schema.json#/$defs/result/properties/cost_evidence"
        },
        "financial_authority": {
          "$ref": "https://fieldruntime.dev/schemas/preparation-work.v1.schema.json#/$defs/result/properties/financial_authority"
        },
        "case_closure_permission": {
          "$ref": "https://fieldruntime.dev/schemas/preparation-work.v1.schema.json#/$defs/result/properties/case_closure_permission"
        },
        "investigation": {
          "$ref": "https://fieldruntime.dev/schemas/investigation.v1.schema.json#/$defs/evidence"
        }
      },
      "required": [
        "schema_version",
        "invocation_id",
        "started_entry_hash",
        "binding_hash",
        "outcome",
        "title",
        "subject",
        "coverage",
        "steps",
        "evidence_checklist",
        "reconciliation",
        "related_context",
        "follow_up",
        "disposition",
        "intervention",
        "proof_readiness",
        "execution_facts",
        "cost_evidence",
        "financial_authority",
        "case_closure_permission",
        "investigation"
      ]
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "preparation-worker-input.v3"
        },
        "invocation_id": {
          "$ref": "https://fieldruntime.dev/schemas/preparation-work.v1.schema.json#/$defs/input/properties/invocation_id"
        },
        "started_entry_hash": {
          "$ref": "https://fieldruntime.dev/schemas/preparation-work.v1.schema.json#/$defs/input/properties/started_entry_hash"
        },
        "binding": {
          "$ref": "#/$defs/binding"
        },
        "artifact": {
          "$ref": "https://fieldruntime.dev/schemas/preparation-pack.v4.schema.json#/$defs/artifact"
        },
        "selected_record": {
          "$ref": "https://fieldruntime.dev/schemas/intake.v1.schema.json#/$defs/record"
        },
        "covered_records": {
          "type": "array",
          "items": {
            "$ref": "https://fieldruntime.dev/schemas/intake.v1.schema.json#/$defs/record"
          },
          "maxItems": 200
        },
        "associated_support_count": {
          "$ref": "https://fieldruntime.dev/schemas/preparation-work.v1.schema.json#/$defs/input/properties/associated_support_count"
        },
        "parsed_utf8_bytes": {
          "$ref": "https://fieldruntime.dev/schemas/preparation-work.v1.schema.json#/$defs/input/properties/parsed_utf8_bytes"
        },
        "retained_bundles": {
          "type": "array",
          "minItems": 1,
