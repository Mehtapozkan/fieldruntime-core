POSTGRES_DB=fieldruntime
POSTGRES_USER=fieldruntime
POSTGRES_PASSWORD=local-evaluation-only
# Host-side tools use 127.0.0.1. Compose injects the internal `postgres` hostname.
DATABASE_URL=postgresql://fieldruntime:local-evaluation-only@127.0.0.1:5432/fieldruntime
FIELD_RUNTIME_MODE=simulation
FIELD_RUNTIME_EXTERNAL_WRITES=false
